        <item name="colorPrimary">@color/primaria</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFE8D9</item>
        <item name="colorOnPrimaryContainer">#5C1D00</item>
        <item name="colorSecondary">@color/cabecalho</item>
        <item name="colorSecondaryContainer">#FFE8D9</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="android:statusBarColor">@color/cabecalho</item>
        <item name="android:windowLightStatusBar">false</item>
